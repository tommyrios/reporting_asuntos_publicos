# Modelo y análisis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash
AAPP_DISABLE_GEMINI=false
AAPP_STRICT_LLM=false

# Google OAuth personal: habilitar Docs API, Drive API y Gmail API si se envía por Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# Google Docs / Drive
GOOGLE_DOCS_FOLDER_ID=
GOOGLE_DOCS_SHARE_WITH=
GOOGLE_DOCS_SHARE_ROLE=writer
GOOGLE_DOCS_ANYONE_WITH_LINK=false

# Envío de link
EMAIL_DELIVERY_MODE=gmail_api   # gmail_api | smtp | none
EMAIL_FROM=
EMAIL_DESTINATARIO=
EMAIL_CC=
EMAIL_BCC=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Parámetros editoriales
REPORT_TIMEZONE=America/Argentina/Buenos_Aires
REPORT_ISSUE_NUMBER=
REPORT_TITLE_PREFIX=Apuntes políticos
REPORT_INTERNAL_LABEL=NOTA INTERNA
REPORT_PERIOD_DAYS=15
AAPP_MIN_CLUSTERS=4
AAPP_MAX_CLUSTERS=8
AAPP_MAX_RAW_NEWS=160

# Programación quincenal: miércoles noche ART. GitHub corre jueves 01:00 UTC.
SCHEDULE_ANCHOR_DATE=2026-05-06
RUN_EVERY_DAYS=14
